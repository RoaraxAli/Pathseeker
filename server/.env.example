PORT=5001

# Get this from MongoDB Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <username>/<password> with your database user credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/pathseeker?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-string

# Seeded admin account — created/updated by `npm run seed:admin`.
# Logs in through the normal /api/auth/login endpoint.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@pathseeker.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Email (for OTP password-reset codes). Using Gmail here — enable 2FA on the
# Google account, then create an App Password at myaccount.google.com/apppasswords
# and use it as EMAIL_PASS (not your regular Gmail password).
# If left unset, OTP codes are printed to the server console instead of emailed,
# so the reset flow still works during development.
EMAIL_SERVICE=gmail
EMAIL_USER=your-address@gmail.com
EMAIL_PASS=replace-with-a-gmail-app-password
EMAIL_FROM=your-address@gmail.com
